{
  "apps": [
    {
      "name": "pinguin-api",
      "script": "apps/api/dist/apps/api/src/index.js",
      "cwd": "..",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production"
      },
      "error_file": "../shared/logs/api-error.log",
      "out_file": "../shared/logs/api-out.log",
      "log_file": "../shared/logs/api-combined.log",
      "merge_logs": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "max_memory_restart": "512M"
    },
    {
      "name": "pinguin-bot",
      "script": "apps/bot/dist/apps/bot/src/index.js",
      "cwd": "..",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production"
      },
      "error_file": "../shared/logs/bot-error.log",
      "out_file": "../shared/logs/bot-out.log",
      "log_file": "../shared/logs/bot-combined.log",
      "merge_logs": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "max_memory_restart": "800M"
    },
    {
      "name": "pinguin-web",
      "script": "node_modules/next/dist/bin/next",
      "args": "start",
      "cwd": "../apps/web",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "error_file": "../shared/logs/web-error.log",
      "out_file": "../shared/logs/web-out.log",
      "log_file": "../shared/logs/web-combined.log",
      "merge_logs": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "max_memory_restart": "512M"
    }
  ]
}
