{
  "name": "@pinguin/api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.3.7",
    "@pinguin/config": "workspace:*",
    "@pinguin/db": "workspace:*",
    "@pinguin/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "pino": "^9.4.0",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.27.0",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
